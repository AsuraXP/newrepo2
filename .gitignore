# Repo artifacts that must never enter Git (spec: three locations).
__pycache__/
*.pyc
.venv/
venv/

# Build artifacts: synthesized audio, timing outputs, videos (Kaggle outputs).
build/

# Generated source images stay out; only reviewed, compressed JPGs are committed.
assets/frames/source/
# ancient_travel_video: the reviewed spine is committed as quantized PNGs in
# ancient_travel_video/frames/. Render JPGs are derived on Kaggle by
# tools/prep_frames.py and must not be committed.
assets/frames/*.jpg
assets/contact_sheet.jpg

# Media binaries.
*.mp3
*.wav
*.m4a
*.mp4
*.webm

# Session scratch.
Unselected files/
*.log

# QC reject sources (audit trail kept in contact sheets)
ancient_travel_video/frames/rejects/
